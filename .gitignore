# dependencies
node_modules/

# build output
client/dist/
client/dist-static/
server/dist/
*.tsbuildinfo

# python bytecode — docx_kit is imported by the doc generators
__pycache__/
*.pyc

# local config and logs — .env holds the Snowflake account, user and key path
.env
*.log

# frames the presales deck generator pulls out of the walkthrough video — a cache,
# regenerated by ffmpeg on demand
tools/.presales_shots/

# the baked snapshots MUST be committed: GitHub Pages builds from them
!client/public/data/

.DS_Store
