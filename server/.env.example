# Cortex Analyst configuration for the "Ask the Ontology" page.
# Copy to server/.env and fill in. Nothing here is read by the other pages —
# the explorer works from data/sc_ontology.json with no Snowflake connection.

# Account identifier, e.g. myorg-myaccount
SNOWFLAKE_ACCOUNT=

SNOWFLAKE_USER=

# Path to an unencrypted PKCS#8 private key. Referenced by path only —
# never paste the key itself into this file.
SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/keys/rsa_key.p8

SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# The semantic view the Ask page is grounded on. Four are available; pick the one
# that matches the questions you want to ask, because they answer different things.
#
#   SAP_SUPPLY_CHAIN.ONTOLOGY.SUPPLY_CHAIN_BASE
#       Concrete lookups: a named plant, supplier or customer; monthly value on a
#       lane; spare capacity; days of inventory. 5 tables, 8 verified queries.
#
#   SAP_SUPPLY_CHAIN.ONTOLOGY.SUPPLY_CHAIN_ONTOLOGY_MODEL
#       Cross-type reasoning over the abstract layer: "which parties", "what kinds
#       of flow", ancestors and descendants. 10 views.
#
#   SAP_SUPPLY_CHAIN.ONTOLOGY.SUPPLY_CHAIN_METADATA_MODEL
#       Governance: how something is modelled, which relations are inferred, which
#       classes map to what. 15 ONT_* tables plus the BDC catalog.
#
#   SAP_BDC_ONTOLOGY.SUPPLY_CHAIN.SUPPLY_CHAIN_ONTOLOGY_MODEL   (default below)
#       The BDC data-product catalog: 36 products, 338 CDS entities. Metadata about
#       data, not the supply chain itself.
#
# Left on the BDC catalog so the Ask page keeps its existing behaviour. To ask
# supply-chain questions instead, switch to SUPPLY_CHAIN_BASE. To route across all
# three automatically, use the agent: SAP_SUPPLY_CHAIN.ONTOLOGY.SUPPLY_CHAIN_AGENT
BDC_SEMANTIC_VIEW=SAP_BDC_ONTOLOGY.SUPPLY_CHAIN.SUPPLY_CHAIN_ONTOLOGY_MODEL

PORT=3009
